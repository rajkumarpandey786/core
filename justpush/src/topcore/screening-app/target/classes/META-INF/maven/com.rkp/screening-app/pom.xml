    <dependencies>

        <dependency>
            <groupId>com.rkp</groupId>
            <artifactId>topcore-core-engine</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.rkp</groupId>
            <artifactId>topcore-plugin-c400</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.rkp</groupId>
            <artifactId>topcore-plugin-tsas</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.rkp</groupId>
            <artifactId>topcore-plugin-paimi</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>